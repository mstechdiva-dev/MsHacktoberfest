# Copy to .env.local for `vercel dev`, and set the same names in Vercel's project settings.

# OpenRouter key for the attendant's note. Leave empty to always use house notes.
OPENROUTER_API_KEY=

# Any long random string. Signs the once-a-day cookie. Leave empty to skip the cookie.
COZY_COOKIE_SECRET=

# Set to 1 to show the "closed for a quick tidy-up" sign.
COZY_MAINTENANCE=0
